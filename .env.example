# Resend transactional email.
# Free plan is enough for MVP waitlist/auth emails.
RESEND_API_KEY=
RESEND_FROM="PRSLOY <hello@prsloy.online>"

# Required for email/password accounts.
# Vercel KV uses KV_REST_API_URL + KV_REST_API_TOKEN.
# Vercel Marketplace Upstash may prefix them as UPSTASH_REDIS_REST_KV_REST_API_*.
# Plain Upstash Redis REST uses UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
AUTH_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin endpoint (POST /api/admin/grant) — manual invite/key issuance.
# Unset = endpoint disabled. Use a long random value (32+ chars).
ADMIN_SECRET=

# Optional: receive waitlist/access-request notifications by email.
WAITLIST_NOTIFY_EMAIL=

# Optional: receive waitlist/access-request notifications in Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Optional canonical / OG URL override.
NEXT_PUBLIC_SITE_URL=https://www.prsloy.online

# Platega checkout.
# Callback URL in Platega cabinet:
# https://www.prsloy.online/api/payments/platega/callback
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_PROCESS_PATH=/transaction/process
PLATEGA_SBP_PAYMENT_METHOD_ID=2

# Marzneshin auto-issue (Issue #4) — proxy to partner's hellcat backend.
# When unset, paid users see /admin/grant fallback (manual issue path).
# Spec: prsloy-infra/marzneshin-api-spec.md.
MARZNESHIN_PROXY_URL=
MARZNESHIN_PROXY_HMAC_SECRET=
MARZNESHIN_PROXY_TIMEOUT_MS=10000
